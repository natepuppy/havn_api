<!DOCTYPE html>
<html>
<head>
  <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
  <title>Password Reset Instructions</title>
</head>
<body>
  <div style="max-width: 600px; margin: auto; padding: 20px; text-align: center;">
    <h1>Password Reset Instructions</h1>
    <p>Someone has requested to change your password. Use the code below on the sign-in page.</p>
    <h2 style="letter-spacing: 0.04em;"><%= @token %></h2>
    <p>
      Or open
      <a href="<%= ENV.fetch("FRONTEND_URL", "http://localhost:5173") %>/login?reset_password_token=<%= @token %>">this reset link</a>.
    </p>
    <p>If you didn't request this, please ignore this email.</p>
  </div>
</body>
</html>
