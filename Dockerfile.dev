# syntax=docker/dockerfile:1
# Development image. Installs every gem group and expects the source to be
# bind-mounted at runtime for live reload.

ARG RUBY_VERSION=3.3.3
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential curl git libjemalloc2 libpq-dev libvips libyaml-dev postgresql-client pkg-config && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

ENV RAILS_ENV="development" \
    BUNDLE_PATH="/usr/local/bundle"

COPY Gemfile Gemfile.lock ./
RUN bundle install

EXPOSE 3000
CMD ["bash", "-c", "bundle check || bundle install && ./bin/rails server -b 0.0.0.0 -p 3000"]
